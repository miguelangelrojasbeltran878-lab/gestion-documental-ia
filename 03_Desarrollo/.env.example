# Copia este archivo a .env y completa tus credenciales. NUNCA subas .env al repositorio.

APP_ENV=development                 # development | production
SECRET_KEY=cambiar_por_una_clave_aleatoria_de_32_o_mas_caracteres
FILE_TOKEN_SECRET=                  # opcional; si se omite se deriva de SECRET_KEY
COOKIE_SECURE=false                 # true detrás de HTTPS (producción)

# Base de datos: SQLite local o PostgreSQL gratuito (Neon/Supabase/Render)
DATABASE_URL=sqlite:///tickets.db
UPLOAD_DIR=storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=

# ---------------- IA (todo en capas gratuitas) ----------------
# Orden de la cadena de proveedores: Gemini -> Groq -> Ollama local -> reglas locales (Plan B)
AI_PROVIDER_ORDER=gemini,groq,ollama
GEMINI_API_KEY=                     # https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=                       # https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=                      # ej. http://localhost:11434 (vacío = Ollama desactivado)
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Ley 1581 de 2012: false = ningún dato sale a servicios externos (solo Ollama/OCR/reglas locales)
AI_EXTERNAL_ALLOWED=true
VISION_REQUIRE_CONSENT=true         # exige autorización expresa para enviar imágenes a servicios externos

# ---------------- Visión ----------------
VISION_MAX_MB=15
VISION_CONFIDENCE_THRESHOLD=0.75
OCR_LANGS=spa+eng                   # requiere Tesseract instalado (opcional)

# ---------------- Motor de automatización ----------------
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_BACKOFF_SECONDS=1.0
SCHEDULER_ENABLED=true              # un solo worker de uvicorn
SLA_ALERT_MINUTES=60
SLA_CHECK_MINUTES=15
RETRY_QUEUE_MINUTES=10

# Administrador inicial: solo se crea si la base de datos no tiene usuarios.
ADMIN_EMAIL=admin@portal.local
ADMIN_PASSWORD=
