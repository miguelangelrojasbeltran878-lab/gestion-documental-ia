# Configuración de Entorno - Sistema Inteligente de Gestión y Análisis Documental
# Copia este archivo a .env y asigna tus credenciales seguras.

# Entorno: development | production
APP_ENV=development

# Clave secreta criptográfica para firmas HMAC y tokens de sesión (genera una aleatoria en producción)
SECRET_KEY=cambiar_por_una_clave_secreta_de_al_menos_32_caracteres_aleatorios_123456789

# URL de la base de datos relacional (SQLite por defecto o PostgreSQL en despliegue)
DATABASE_URL=sqlite:///tickets.db

# Directorio de almacenamiento para archivos subidos y documentos escaneados
UPLOAD_DIR=storage

# URL pública base del portal (ej. http://127.0.0.1:8000 o https://tu-dominio.onrender.com)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Lista de orígenes permitidos para CORS (separados por coma, opcional)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# -------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL Y VISIÓN MULTIMODAL (Google Gemini Nivel Gratuito)
# -------------------------------------------------------------
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
# Si se deja vacía, el sistema activará automáticamente el PLAN B (reglas locales y OCR heurístico)
GEMINI_API_KEY=

# Modelo recomendado para visión y texto multimodal
GEMINI_MODEL=gemini-2.5-flash

# Tiempo máximo de espera en segundos antes de activar Plan B
AI_TIMEOUT_SECONDS=30

# Número máximo de reintentos con retroceso exponencial
AI_MAX_RETRIES=2

# Autorización explícita para envío de datos a API externa (Cumplimiento Ley 1581 de 2012)
# Si es false, se deshabilita la conexión externa y solo se opera con modelos y reglas locales
AI_EXTERNAL_ALLOWED=true

# -------------------------------------------------------------
# PARÁMETROS DE VISIÓN POR COMPUTADOR Y AUTOMATIZACIÓN
# -------------------------------------------------------------
# Tamaño máximo en megabytes para imágenes y documentos escaneados (.jpg, .png, .pdf)
VISION_MAX_MB=10

# Umbral mínimo de confianza (0.0 a 1.0) para requerir revisión humana obligatoria
VISION_CONFIDENCE_THRESHOLD=0.75

# Reintentos del motor de automatización
AUTOMATION_MAX_ATTEMPTS=3

# Usuario Administrador inicial por defecto
ADMIN_EMAIL=andres.gomez@empresa.com
ADMIN_PASSWORD=Password123*
